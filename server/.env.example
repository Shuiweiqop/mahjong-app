# 后端环境变量示例。复制为 .env 填本地值;线上在 Render 后台设置。
PORT=3001

# JWT 签名密钥(至少 16 字符;线上用强随机值,Render 可自动生成)。
# 设了 DATABASE_URL(视为生产)却没设本项 → 服务拒绝启动。
# 本地不设则每次启动用随机密钥(重启后登录态失效),不会退回固定值。
# 生成:node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Postgres 连接串(来自 Supabase → Project Settings → Database → Connection string → URI)
# 本地留空则自动用内存存储(无需数据库)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres

# 允许的前端来源(逗号分隔;线上填 Vercel 域名)。留空则放开(本地开发)
# CLIENT_ORIGIN=https://your-app.vercel.app
